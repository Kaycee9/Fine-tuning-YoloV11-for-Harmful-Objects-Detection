,"execution_count":null},{"cell_type":"code","source":"import os\nimport random\nimport glob\nimport json\nimport zipfile\nimport urllib.request\nimport numpy as np\nimport pandas as pd\nimport tensorflow as tf\nimport tensorflow_hub as hub\nimport librosa\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.utils.class_weight import compute_class_weight\nfrom sklearn.metrics import classification_report, confusion_matrix\n \nSAMPLE_RATE = 16000          # YAMNet requires 16kHz mono\nCLIP_DURATION = 4.0          # seconds — pad/truncate every clip to this length\nWORKING_DIR = \"/kaggle/working\"\nos.makedirs(WORKING_DIR, exist_ok=True)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T11:26:34.757631Z","iopub.execute_input":"2026-06-17T11:26:34.758493Z","iopub.status.idle":"2026-06-17T11:26:34.763944Z","shell.execute_reply.started":"2026-06-17T11:26:34.758458Z","shell.execute_reply":"2026-06-17T11:26:34.76311Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#  Locate the datasets (robust to nested folder structures)\ndef find_one(root, target_filename):\n    \"\"\"Walk `root` looking for a file named `target_filename`, return its full path.\"\"\"\n    for dirpath, _, filenames in os.walk(root):\n        if target_filename in filenames:\n            return os.path.join(dirpath, target_filename)\n    raise FileNotFoundError(f\"Could not find {target_filename} under {root}\")\n\n\ndef index_wavs_by_basename(root):\n    \"\"\"Walk `root` and return {basename: full_path} for every .wav file found.\"\"\"\n    index = {}\n    for dirpath, _, filenames in os.walk(root):\n        for f in filenames:\n            if f.lower().endswith(\".wav\"):\n                index[f] = os.path.join(dirpath, f)\n    return index\n\n\nINPUT_DIR = \"/kaggle/input\"\nprint(\"Datasets available under /kaggle/input:\")\nfor d in os.listdir(INPUT_DIR):\n    print(\" -\", d)\n\n# These will auto-detect regardless of exact subfolder nesting\nurbansound_csv = find_one(INPUT_DIR, \"UrbanSound8K.csv\")\nesc50_csv = find_one(INPUT_DIR, \"esc50.csv\")\n\n# Instead of guessing how many folder levels to climb above each CSV\n# (fragile — Kaggle's nesting can vary), just index every .wav file\n# under the entire /kaggle/input tree once. UrbanSound8K filenames\n# (e.g. \"103074-7-0-0.wav\") and ESC-50 filenames (e.g. \"1-100032-A-0.wav\")\n# follow distinct enough patterns that collisions aren't a concern.\nall_wavs = index_wavs_by_basename(INPUT_DIR)\nprint(f\"Found {len(all_wavs)} total wav files under /kaggle/input\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T11:26:38.885957Z","iopub.execute_input":"2026-06-17T11:26:38.886248Z","iopub.status.idle":"2026-06-17T11:26:54.236952Z","shell.execute_reply.started":"2026-06-17T11:26:38.886208Z","shell.execute_reply":"2026-06-17T11:26:54.236269Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#  let's build a unified (filepath, label) table \nTHREAT_MAP_US8K = {\n    \"gun_shot\": \"gunshot\",\n    \"siren\": \"siren_alarm\",\n}\nTHREAT_MAP_ESC50 = {\n    \"glass_breaking\": \"glass_breaking\",\n    \"siren\": \"siren_alarm\",\n    \"clock_alarm\": \"siren_alarm\",\n    \"fireworks\": \"explosion\",\n}\nBACKGROUND_US8K = [\"dog_bark\", \"street_music\", \"children_playing\",\n                    \"engine_idling\", \"drilling\", \"air_conditioner\", \"jackhammer\"]\nBACKGROUND_ESC50 = [\"rain\", \"wind\", \"footsteps\", \"laughing\", \"door_wood_creaks\",\n                     \"vacuum_cleaner\", \"car_horn\", \"engine\", \"chirping_birds\", \"train\"]\n\nrecords = []\n\nus8k_df = pd.read_csv(urbansound_csv)\nfor _, row in us8k_df.iterrows():\n    cls = row[\"class\"]\n    label = THREAT_MAP_US8K.get(cls) or (\"background\" if cls in BACKGROUND_US8K else None)\n    if label is None:\n        continue\n    fname = row[\"slice_file_name\"]\n    path = all_wavs.get(fname)\n    if path:\n        records.append({\"filepath\": path, \"label\": label})\n\nesc50_df = pd.read_csv(esc50_csv)\nfor _, row in esc50_df.iterrows():\n    cls = row[\"category\"]\n    label = THREAT_MAP_ESC50.get(cls) or (\"background\" if cls in BACKGROUND_ESC50 else None)\n    if label is None:\n        continue\n    fname = row[\"filename\"]\n    path = all_wavs.get(fname)\n    if path:\n        records.append({\"filepath\": path, \"label\": label})\n\ndata_df = pd.DataFrame(records)\nprint(\"Before capping background:\")\nprint(data_df[\"label\"].value_counts())\n\nBACKGROUND_CAP = 1500\nbackground_df = data_df[data_df[\"label\"] == \"background\"]\nother_df = data_df[data_df[\"label\"] != \"background\"]\nif len(background_df) > BACKGROUND_CAP:\n    background_df = background_df.sample(n=BACKGROUND_CAP, random_state=42)\ndata_df = pd.concat([background_df, other_df], ignore_index=True)\n\nprint(\"After capping background:\")\nprint(data_df[\"label\"].value_counts())\ndata_df.to_csv(os.path.join(WORKING_DIR, \"combined_file_index.csv\"), index=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T11:27:02.417565Z","iopub.execute_input":"2026-06-17T11:27:02.418042Z","iopub.status.idle":"2026-06-17T11:27:02.889182Z","shell.execute_reply.started":"2026-06-17T11:27:02.418008Z","shell.execute_reply":"2026-06-17T11:27:02.888323Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\ncache_path = \"/kaggle/working/embeddings.npz\"\nif os.path.exists(cache_path):\n    os.remove(cache_path)\n    print(\"Deleted:\", cache_path)\nelse:\n    print(\"No cache file found at that path — nothing to delete.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T11:27:10.808338Z","iopub.execute_input":"2026-06-17T11:27:10.809366Z","iopub.status.idle":"2026-06-17T11:27:10.81657Z","shell.execute_reply.started":"2026-06-17T11:27:10.809321Z","shell.execute_reply":"2026-06-17T11:27:10.815673Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#Load YAMNet and extract embeddings \nprint(\"Loading YAMNet from TF-Hub...\")\nyamnet_model = hub.load(\"https://tfhub.dev/google/yamnet/1\")\n\n\ndef load_wav_16k_mono(path):\n    wav, _ = librosa.load(path, sr=SAMPLE_RATE, mono=True)\n    target_len = int(SAMPLE_RATE * CLIP_DURATION)\n    if len(wav) < target_len:\n        wav = np.pad(wav, (0, target_len - len(wav)))\n    else:\n        wav = wav[:target_len]\n    return wav.astype(np.float32)\n\n\ndef extract_embedding(wav):\n    _, embeddings, _ = yamnet_model(wav)\n    return tf.reduce_mean(embeddings, axis=0).numpy()\n\n\ndef augment_audio(wav, sr=SAMPLE_RATE):\n    target_len = int(sr * CLIP_DURATION)\n    aug_type = random.choice([\"noise\", \"pitch\", \"stretch\"])\n    if aug_type == \"noise\":\n        noise_amp = 0.005 * np.random.uniform() * (np.amax(np.abs(wav)) + 1e-6)\n        wav = wav + noise_amp * np.random.normal(size=wav.shape[0])\n    elif aug_type == \"pitch\":\n        wav = librosa.effects.pitch_shift(wav, sr=sr, n_steps=random.uniform(-2, 2))\n    elif aug_type == \"stretch\":\n        wav = librosa.effects.time_stretch(wav, rate=random.uniform(0.85, 1.15))\n    if len(wav) < target_len:\n        wav = np.pad(wav, (0, target_len - len(wav)))\n    else:\n        wav = wav[:target_len]\n    return wav.astype(np.float32)\n\n\nEMB_CACHE = os.path.join(WORKING_DIR, \"embeddings.npz\")\nif os.path.exists(EMB_CACHE):\n    print(\"Loading cached embeddings...\")\n    cache = np.load(EMB_CACHE, allow_pickle=True)\n    X, y_raw = cache[\"X\"], cache[\"y\"]\nelse:\n    AUGMENT_TARGET_COUNT = 300\n    label_counts = data_df[\"label\"].value_counts().to_dict()\n    print(\"Label counts feeding into augmentation decision:\", label_counts)\n\n    print(f\"Extracting embeddings for {len(data_df)} files (plus augmentation for rare classes)...\")\n    X_list, y_list = [], []\n    for i, row in data_df.iterrows():\n        label = row[\"label\"]\n        try:\n            wav = load_wav_16k_mono(row[\"filepath\"])\n            X_list.append(extract_embedding(wav))\n            y_list.append(label)\n\n            if label != \"background\" and label_counts.get(label, 0) < AUGMENT_TARGET_COUNT:\n                n_needed = AUGMENT_TARGET_COUNT - label_counts[label]\n                n_per_clip = max(1, n_needed // label_counts[label])\n                for _ in range(n_per_clip):\n                    aug_wav = augment_audio(wav)\n                    X_list.append(extract_embedding(aug_wav))\n                    y_list.append(label)\n        except Exception as e:\n            print(f\"Skipping {row['filepath']}: {e}\")\n        if i % 200 == 0:\n            print(f\"  {i}/{len(data_df)}\")\n    X, y_raw = np.array(X_list), np.array(y_list)\n    np.savez(EMB_CACHE, X=X, y=y_raw)\n\nprint(\"Embeddings shape:\", X.shape)\nprint(\"Final label distribution after augmentation:\", pd.Series(y_raw).value_counts().to_dict())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T11:27:15.502943Z","iopub.execute_input":"2026-06-17T11:27:15.503781Z","iopub.status.idle":"2026-06-17T11:28:05.981626Z","shell.execute_reply.started":"2026-06-17T11:27:15.503741Z","shell.execute_reply":"2026-06-17T11:28:05.980897Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Encode labels, split, compute class weights \nclasses = sorted(np.unique(y_raw))\nclass_to_idx = {c: i for i, c in enumerate(classes)}\ny = np.array([class_to_idx[c] for c in y_raw])\nnum_classes = len(classes)\nprint(\"Classes:\", classes)\n\nX_train, X_val, y_train, y_val = train_test_split(\n    X, y, test_size=0.2, stratify=y, random_state=42\n)\n\nUSE_SMOTE = True\nif USE_SMOTE:\n    from imblearn.over_sampling import SMOTE\n    smallest_class_size = pd.Series(y_train).value_counts().min()\n    k_neighbors = max(1, min(5, smallest_class_size - 1))\n    smote = SMOTE(random_state=42, k_neighbors=k_neighbors)\n    X_train, y_train = smote.fit_resample(X_train, y_train)\n    print(\"After SMOTE, train label distribution:\", pd.Series(y_train).value_counts().to_dict())\n\nclass_weights_arr = compute_class_weight(\"balanced\", classes=np.arange(num_classes), y=y_train)\nclass_weight_dict = {i: w for i, w in enumerate(class_weights_arr)}\nprint(\"Class weights:\", class_weight_dict)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T11:28:19.128662Z","iopub.execute_input":"2026-06-17T11:28:19.129487Z","iopub.status.idle":"2026-06-17T11:28:19.232462Z","shell.execute_reply.started":"2026-06-17T11:28:19.129455Z","shell.execute_reply":"2026-06-17T11:28:19.23159Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#Build and train the classifier head \ndef build_classifier(input_dim, num_classes):\n    model = tf.keras.Sequential([\n        tf.keras.layers.Input(shape=(input_dim,)),\n        tf.keras.layers.Dense(256, activation=\"relu\"),\n        tf.keras.layers.Dropout(0.3),\n        tf.keras.layers.Dense(128, activation=\"relu\"),\n        tf.keras.layers.Dropout(0.3),\n        tf.keras.layers.Dense(num_classes, activation=\"softmax\"),\n    ])\n    model.compile(\n        optimizer=tf.keras.optimizers.Adam(learning_rate=1e-3),\n        loss=\"sparse_categorical_crossentropy\",\n        metrics=[\"accuracy\"],\n    )\n    return model\n \n \nclassifier = build_classifier(input_dim=1024, num_classes=num_classes)\nclassifier.summary()\n \ncallbacks = [tf.keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=6, restore_best_weights=True)]\n \nhistory = classifier.fit(\n    X_train, y_train,\n    validation_data=(X_val, y_val),\n    epochs=100,\n    batch_size=32,\n    class_weight=class_weight_dict,\n    callbacks=callbacks,\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T11:28:24.052831Z","iopub.execute_input":"2026-06-17T11:28:24.053449Z","iopub.status.idle":"2026-06-17T11:28:36.477829Z","shell.execute_reply.started":"2026-06-17T11:28:24.053409Z","shell.execute_reply":"2026-06-17T11:28:36.477138Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Evaluate \ny_pred = np.argmax(classifier.predict(X_val), axis=1)\nprint(classification_report(y_val, y_pred, target_names=classes))\nprint(confusion_matrix(y_val, y_pred))\n \n \n# ---- CELL 8: Save Keras model + label map ----\nclassifier.save(os.path.join(WORKING_DIR, \"sound_threat_classifier.keras\"))\nwith open(os.path.join(WORKING_DIR, \"label_classes.json\"), \"w\") as f:\n    json.dump(classes, f)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T11:28:48.77485Z","iopub.execute_input":"2026-06-17T11:28:48.775134Z","iopub.status.idle":"2026-06-17T11:28:49.329337Z","shell.execute_reply.started":"2026-06-17T11:28:48.775111Z","shell.execute_reply":"2026-06-17T11:28:49.328619Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Export for Raspberry Pi \nyamnet_tflite_path = os.path.join(WORKING_DIR, \"yamnet.tflite\")\nyamnet_tflite_url = \"https://tfhub.dev/google/lite-model/yamnet/tflite/1?lite-format=tflite\"\nprint(\"Downloading YAMNet TFLite model...\")\nurllib.request.urlretrieve(yamnet_tflite_url, yamnet_tflite_path)\nassert os.path.getsize(yamnet_tflite_path) > 0, \"YAMNet TFLite download failed — check Internet is ON in notebook settings\"\nprint(\"Saved:\", yamnet_tflite_path, os.path.getsize(yamnet_tflite_path), \"bytes\")\n\nconverter = tf.lite.TFLiteConverter.from_keras_model(classifier)\nconverter.optimizations = [tf.lite.Optimize.DEFAULT]\nclassifier_tflite = converter.convert()\n\nclassifier_tflite_path = os.path.join(WORKING_DIR, \"sound_threat_classifier.tflite\")\nwith open(classifier_tflite_path, \"wb\") as f:\n    f.write(classifier_tflite)\nprint(\"Saved:\", classifier_tflite_path, os.path.getsize(classifier_tflite_path), \"bytes\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T11:33:35.749984Z","iopub.execute_input":"2026-06-17T11:33:35.750788Z","iopub.status.idle":"2026-06-17T